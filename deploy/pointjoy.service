[Unit]
Description=PointJoy API
After=network.target postgresql.service

[Service]
Type=simple
User=pointjoy
Group=pointjoy
WorkingDirectory=/opt/pointjoy/api
EnvironmentFile=/etc/pointjoy/api.env
ExecStart=/opt/pointjoy/runtime/bin/node dist/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pointjoy/avatars
MemoryMax=384M

[Install]
WantedBy=multi-user.target
